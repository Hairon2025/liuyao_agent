# 应用配置
APP_NAME=liuyao-agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite 默认路径；部署时可替换成其他 SQLAlchemy 异步数据库 URL
DATABASE_URL=sqlite+aiosqlite:///./backend/running_data/liuyao.db

# LLM 配置
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=120 # 请求超时时间，单位秒

# 追问建议模型（可接入另一家便宜模型；留空时回退到上面的 LLM 配置）
SUGGESTION_LLM_API_KEY=
SUGGESTION_LLM_BASE_URL=
SUGGESTION_LLM_MODEL=deepseek-v4-flash
SUGGESTION_LLM_TIMEOUT_SECONDS=30
SUGGESTION_CONTEXT_MAX_CHARS=1400
SUGGESTION_USER_MESSAGE_MAX_CHARS=300

# 长期记忆摘要模型（留空时逐项回退到主 LLM 配置）
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT_SECONDS=30
MEMORY_SUMMARY_TRIGGER_ITEMS=10 # 未压缩 SDK Item 达到多少条时触发摘要
MEMORY_SUMMARY_KEEP_RECENT_ITEMS=5 # 摘要后至少保留多少条；截断点会回退到完整用户轮次
MEMORY_SUMMARY_INPUT_MAX_CHARS=16000

# OpenAI Agents SDK
CHAT_MAX_STEPS=6 # 单轮对话最多允许的模型/工具循环次数
CHAT_CONTEXT_RECENT_LIMIT=10 # SDK SQLAlchemySession 每轮最多读取多少条最近 Item

# CORS
CORS_ORIGINS=["*"]
