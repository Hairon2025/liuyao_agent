# 应用配置
APP_NAME=liuyao-agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite 默认路径；部署时可替换成其他 SQLAlchemy 异步数据库 URL
DATABASE_URL=sqlite+aiosqlite:///./backend/running_data/liuyao.db

# LLM 配置
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=120

# Chatbot ReAct 与上下文摘要
CHAT_MAX_STEPS=6
CHAT_CONTEXT_RECENT_LIMIT=50
CHAT_SUMMARY_TRIGGER_MESSAGES=40
CHAT_SUMMARY_KEEP_RECENT=12

# CORS
CORS_ORIGINS=["*"]
