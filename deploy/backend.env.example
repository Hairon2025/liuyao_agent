# Docker 后端运行配置。复制为 deploy/backend.env 后使用。
APP_NAME=liuyao-agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# Caddy 会移除 /api 前缀后再转发；ROOT_PATH 用于 Swagger 生成正确的公开 URL。
ROOT_PATH=/api

# 数据库只挂载 /data，不覆盖 backend/running_data 下的静态卦象数据。
DATABASE_URL=sqlite+aiosqlite:////data/liuyao.db

# 当前是 IP + HTTP 测试，所以 Secure 必须为 false。
AUTH_COOKIE_NAME=liuyao_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# 测试阶段可以留空：后端会在持久化数据卷中自动创建主密钥。
# 正式上线建议使用 `openssl rand -hex 32` 生成并固定配置。
USER_LLM_ENCRYPTION_KEY=
USER_LLM_ENCRYPTION_KEY_FILE=/data/.user_llm_encryption_key
ALLOW_PRIVATE_LLM_BASE_URLS=false

# 前后端通过同一个 IP 和 8080 端口访问，不需要跨域。
CORS_ORIGINS=[]

# Chatbot 与上下文摘要策略；实际模型连接由每名注册用户自行配置。
CHAT_MAX_STEPS=3
CHAT_CONTEXT_RECENT_LIMIT=10
MEMORY_SUMMARY_TRIGGER_ITEMS=10
MEMORY_SUMMARY_KEEP_RECENT_ITEMS=5
MEMORY_SUMMARY_INPUT_MAX_CHARS=6000
SUGGESTION_CONTEXT_MAX_CHARS=1400
SUGGESTION_USER_MESSAGE_MAX_CHARS=300
